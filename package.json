{
  "name": "rits-2026-fall-cartography",
  "version": "1.0.0",
  "description": "立命館大学 2026年度 秋セメスター 火曜5限 ウェブカートグラフィ入門 授業スライド",
  "main": "index.js",
  "scripts": {
    "build": "marp -I slides/ -o output/ && cp -r ./slides/images ./output/images",
    "build:pdf": "marp -I slides/ --pdf -o output/pdf/",
    "build:pptx": "marp -I slides/ --pptx -o output/pptx/",
    "build:all": "rm -rf output && pnpm build && pnpm build:pdf && pnpm build:pptx",
    "dev": "marp -s -I slides/"
  },
  "keywords": [
    "cartography",
    "maplibre",
    "openstreetmap",
    "slides",
    "education"
  ],
  "author": "kamataryo (ryo@kamataworks.com)",
  "license": "MIT",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
